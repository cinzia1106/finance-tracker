# Copy to .env.local for local development. NEVER commit real values.
#
# Only these two public (client-safe) variables are allowed in the frontend.
# Data isolation is enforced by Supabase Row Level Security, not by secrecy
# of these values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# FORBIDDEN in this repository and in any frontend code or CI config:
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_SECRET_KEY
# Those keys bypass RLS and must never leave the Supabase dashboard.
